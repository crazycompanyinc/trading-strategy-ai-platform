{
  "name": "trading-strategy-ai-platform",
  "version": "1.0.0",
  "description": "AI-powered desktop platform for trading strategy research via natural language",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "react-scripts start",
    "build": "react-scripts build && electron-builder",
    "build:react": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src/"
  },
  "keywords": ["trading", "strategy", "backtesting", "ai", "metatrader", "mql5"],
  "author": "crazycompanyinc",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7",
    "react-dropzone": "^14.2.3",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "react-scripts": "5.0.1",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18"
  },
  "build": {
    "appId": "com.crazycompanyinc.trading-strategy-ai",
    "productName": "Trading Strategy AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version"]
  }
}
