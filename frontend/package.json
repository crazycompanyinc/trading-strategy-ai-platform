{
  "name": "trading-strategy-ai-platform",
  "version": "1.0.0",
  "description": "AI-powered desktop platform for trading strategy research via natural language",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "react-scripts start",
    "build": "react-scripts build && electron-builder --win",
    "build:react": "react-scripts build",
    "build:win": "react-scripts build && electron-builder --win nsis",
    "build:portable": "react-scripts build && electron-builder --win portable",
    "test": "react-scripts test",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": ["trading", "strategy", "backtesting", "ai", "metatrader", "mql5"],
  "author": "crazycompanyinc",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.crazycompanyinc.trading-strategy-ai",
    "productName": "Trading Strategy AI",
    "copyright": "Copyright (c) 2026 crazycompanyinc",
    "extends": null,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "publisherName": "crazycompanyinc",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "artifactName": "TradingStrategyAI-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trading Strategy AI",
      "artifactName": "TradingStrategyAI-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "TradingStrategyAI-Portable-${version}.exe"
    }
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version"]
  }
}
